++        }
++    }
++
++    /** Parte local del correo (lo que precede a la arroba). */
++    public String usuario() {
++        return valor.substring(0, valor.indexOf('@'));
++    }
++
++    /** Dominio del correo (lo que sigue a la arroba). */
++    public String dominio() {
